{
  "name": "stagepilot",
  "version": "1.0.0",
  "description": "StagePilot – AI Co-Pilot for Live Events",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:standalone": "node --watch server.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start": "node server.js",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint .",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.441.0",
    "mongodb": "^7.6.0",
    "mongoose": "^8.9.5",
    "node-releases": "^2.0.56",
    "openai": "^4.83.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "source-map": "^0.6.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "postcss": "^8.4.47",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.11",
    "vite": "^5.4.5"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "keywords": [
    "stagepilot",
    "event-management",
    "ai-copilot",
    "socket.io",
    "react",
    "teleprompter"
  ],
  "author": "StagePilot Team",
  "license": "MIT"
}
